  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/alive/[action].js": {
      "includeFiles": "development/**/*,alive/server/**/*",
      "maxDuration": 30
    },
    "api/alive/auth/[...all].js": {
      "includeFiles": "alive/server/**/*",
      "maxDuration": 30
    }
  }
}
